# Copy this file to .env and fill in the values. Never commit .env!

# true = in-memory sheet with demo data (no Google needed; Telegram tokens still needed for `run`)
MOCK=false

# Bot #1 (can only DEDUCT) and bot #2 (can AWARD and DEDUCT), tokens from @BotFather
DEDUCT_BOT_TOKEN=
POINTS_BOT_TOKEN=

# The long ID in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SPREADSHEET_ID=
# Path to the service account JSON key downloaded from Google Cloud
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Optional
TIMEZONE=Europe/Vilnius        # used to display times; the sheet stores UTC
MAX_AMOUNT=100000              # largest amount accepted in one operation
CONFIRM_TIMEOUT_SECONDS=300    # how long the Yes/No buttons stay valid
USERS_CACHE_SECONDS=30         # how quickly changes in the Users sheet are picked up
LOG_LEVEL=INFO
